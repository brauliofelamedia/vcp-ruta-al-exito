# ==========================================================
# VCP · Ruta del Éxito · Variables de Entorno
# ==========================================================

# Supabase (Configuración obligatoria)
SUPABASE_URL=https://tu-proyecto.supabase.co
# Se recomienda usar la Service Role Key para las Serverless Functions de Vercel
# (Tiene permisos completos para leer y escribir en la base de datos de forma segura)
SUPABASE_SERVICE_ROLE_KEY=tu_supabase_service_role_key
# Alternativa: Anon key (si prefieres usar la clave pública con RLS)
SUPABASE_ANON_KEY=tu_supabase_anon_key

# GoHighLevel (Configuración opcional / según el método preferido)
# Método 1: Webhook directo a Workflow de GoHighLevel (El más sencillo y recomendado)
GHL_WEBHOOK_URL=https://services.leadconnectorhq.com/hooks/tu_webhook_aqui

# Método 2: API directa de GoHighLevel v2
GHL_API_KEY=tu_ghl_private_token_o_api_key
GHL_LOCATION_ID=tu_location_id_de_ghl
